{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "place.schema.json",
  "title": "Travel atlas place",
  "type": "object",
  "required": [
    "id",
    "name",
    "country",
    "format",
    "center",
    "radiusMeters",
    "visits"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "country": {
      "type": "string",
      "minLength": 1
    },
    "format": {
      "enum": [
        "A6",
        "A7"
      ]
    },
    "center": {
      "type": "object",
      "required": [
        "lat",
        "lon"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "additionalProperties": false
    },
    "radiusMeters": {
      "type": "integer",
      "minimum": 300,
      "maximum": 15000
    },
    "note": {
      "type": "string"
    },
    "visits": {
      "type": "object",
      "required": [
        "me",
        "partner",
        "shared"
      ],
      "properties": {
        "me": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "partner": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "shared": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "description": "'shared' = travelled together at the same time (sun and moon are linked); 'me' = sun; 'partner' = moon."
    },
    "landmarks": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "name",
          "lat",
          "lon"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "lat": {
            "type": "number"
          },
          "lon": {
            "type": "number"
          },
          "art": {
            "type": "string"
          },
          "artWidthMm": {
            "type": "number",
            "minimum": 2,
            "maximum": 30
          },
          "artDxMm": {
            "type": "number",
            "minimum": -30,
            "maximum": 30
          },
          "artDyMm": {
            "type": "number",
            "minimum": -30,
            "maximum": 30
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
