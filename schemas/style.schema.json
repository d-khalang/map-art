{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "style.schema.json",
  "title": "Travel atlas style",
  "type": "object",
  "required": ["id", "palette", "roadWidths", "waterWidths", "detail", "ai"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "palette": {
      "type": "object",
      "required": ["paper", "ink", "muted", "water", "park", "building", "accent"],
      "additionalProperties": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
    },
    "roadWidths": {
      "type": "object",
      "required": ["motorway", "primary", "secondary", "local", "minor", "rail"],
      "additionalProperties": { "type": "number", "minimum": 0 }
    },
    "waterWidths": {
      "type": "object",
      "required": ["river", "canal", "stream"],
      "properties": {
        "river": { "type": "number", "minimum": 0 },
        "canal": { "type": "number", "minimum": 0 },
        "stream": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "detail": {
      "type": "object",
      "required": ["showMinorRoads", "showBuildings", "maxPoiLabels"],
      "properties": {
        "showMinorRoads": { "type": "boolean" },
        "showBuildings": { "type": "boolean" },
        "maxPoiLabels": { "type": "integer", "minimum": 0, "maximum": 12 }
      },
      "additionalProperties": false
    },
    "ai": {
      "type": "object",
      "required": ["strength", "prompt", "protectedGeometry"],
      "properties": {
        "strength": { "enum": ["low", "medium", "high"] },
        "underlaySaturation": { "type": "number", "minimum": 0, "maximum": 1 },
        "prompt": { "type": "string" },
        "protectedGeometry": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
