{
  "$schema": "../schemas/style.schema.json",
  "id": "cartographic",
  "palette": {
    "paper": "#F4F0E6",
    "ink": "#26302E",
    "muted": "#716F67",
    "water": "#A9CBD2",
    "park": "#C9D3B0",
    "building": "#DED5C5",
    "accent": "#C8563E"
  },
  "roadWidths": {
    "motorway": 2.8,
    "primary": 2.2,
    "secondary": 1.7,
    "local": 1.1,
    "minor": 0.65,
    "rail": 0.8
  },
  "waterWidths": {
    "river": 10,
    "canal": 6,
    "stream": 3
  },
  "detail": {
    "showMinorRoads": true,
    "showBuildings": false,
    "maxPoiLabels": 2
  },
  "ai": {
    "strength": "low",
    "underlaySaturation": 0.18,
    "prompt": "Add restrained paper texture, sparse hand-painted vegetation, and subtle watercolour variation. Preserve the exact map composition. Do not add, remove, bend, or reconnect roads, rivers, shorelines, bridges, or landmarks. Add no text.",
    "protectedGeometry": ["roads", "rail", "water-edges", "landmark-anchors"]
  }
}
